@font-face{font-family:ForgeFA;src:url('fontawesome-webfont.ttf') format('truetype');font-weight:normal;font-style:normal;font-display:block;}
.fa{font-family:ForgeFA!important;font-style:normal;font-weight:normal!important;}

/* ForgePC Mauricie — Accueil final basé sur la maquette approuvée */
.home-page{
  background:#02090b;
  color:#f2f2f2;
}
.home-page .container{
  width:min(1400px, calc(100% - 40px));
  max-width:none;
  margin:0 auto;
}
.home-page .site-header .container.nav{
  width:min(1400px, calc(100% - 40px));
}
.home-page .site-header .logo{
  content:url('forgepc-logo-officiel.png') !important;
}
.home-page .site-header .nav{
  min-height:76px;
}
.home-page .nav-phone,.home-page .nav-social{
  display:none;
  align-items:center;
  font-size:11px;
  font-weight:800;
  white-space:nowrap;
}
.home-page .nav-phone{display:none}
.home-page .nav-social{display:none}
.home-page .nav-location{order:10}
.mobile-location{display:none}

/* Hero */
.home-page .home-hero{
  min-height:338px;
  border-bottom:1px solid #29383d;
  background:
    linear-gradient(90deg,rgba(0,8,10,.95) 0%,rgba(0,8,10,.78) 38%,rgba(0,8,10,.22) 67%,rgba(0,8,10,.10) 100%),
    url('service-gaming-maquette.jpg') center/cover no-repeat;
}
.home-page .home-hero-inner{
  min-height:338px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  position:relative;
}
.home-page .home-copy{
  max-width:600px;
  padding:0;
}
.home-page .kicker{
  color:#ff5a00;
  font-weight:900;
  letter-spacing:4px;
  font-size:16px;
}
.home-page .home-copy h1{
  font-size:52px;
  line-height:.98;
  margin:9px 0 12px;
  letter-spacing:.4px;
}
.home-page .home-copy h1 span{display:block;color:#ff5a00}
.home-page .home-copy p{
  font-size:18px;
  line-height:1.3;
  margin:0;
  max-width:570px;
}
.home-page .script{
  margin-top:17px;
  color:#fff;
  font-size:22px;
  line-height:1.05;
  font-style:italic;
  transform:rotate(-4deg);
  display:inline-block;
}
.home-page .home-points{
  width:300px;
  display:grid;
  grid-template-columns:1fr;
  gap:18px;
}
.home-page .home-point{
  display:grid;
  grid-template-columns:48px 1fr;
  align-items:center;
  gap:10px;
}
.home-page .home-point .icon{
  color:#ff5a00;
  font-size:34px;
  text-align:center;
}
.home-page .home-point strong{
  font-size:14px;
  display:block;
}
.home-page .home-point small{
  display:block;
  color:#ddd;
  font-size:12px;
  line-height:1.2;
  margin-top:2px;
}

/* Generic section headings */
.home-page .section{
  padding:14px 0;
  border-bottom:1px solid #25363c;
}
.home-page .title-line{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:20px;
}
.home-page .title-line:before,.home-page .title-line:after{
  content:"";
  height:3px;
  width:82px;
  background:#ff5a00;
}
.home-page .section-title{
  margin:0;
  text-transform:uppercase;
  font-size:28px;
  letter-spacing:.3px;
}
.home-page .section-sub{
  text-align:center;
  color:#d9dddd;
  font-size:14px;
  margin:2px 0 13px;
}

/* Inventory */
.home-inventory .inventory-feature{
  position:relative;
  height:235px;
  overflow:hidden;
  border:1px solid #34454b;
  border-radius:5px;
  background:#041014;
}
.home-inventory .inventory-feature img{
  width:100%;
  height:100%;
  object-fit:cover;
  image-rendering:auto;
  display:block;
  filter:brightness(.9);
}
.home-inventory .inventory-feature .btn{
  position:absolute;
  left:50%;
  bottom:18px;
  transform:translateX(-50%);
  min-width:225px;
  border-color:#ff5a00;
}

/* Why */
.home-why{padding-top:14px;padding-bottom:14px}
.why-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  border:1px solid #26383e;
  border-radius:5px;
  overflow:hidden;
}
.why-grid article{
  min-height:145px;
  padding:16px 12px;
  text-align:center;
  background:#020b0f;
  border-right:1px solid #26383e;
}
.why-grid article:last-child{border-right:0}
.why-icon{color:#ff5a00;font-size:35px;line-height:1}
.why-grid h3{font-size:16px;margin:9px 0 5px}
.why-grid p{font-size:12px;line-height:1.3;color:#d4d8d9;margin:0}

/* About */
.home-about .about{
  display:grid;
  grid-template-columns:420px 1fr;
  gap:32px;
  align-items:center;
}
.home-about .about img{
  width:100%;
  height:220px;
  object-fit:cover;
  border-radius:4px;
}
.home-about .about-copy h2{
  font-size:25px;
  margin:0;
}
.home-about .about-copy .title-line{
  justify-content:flex-start;
  gap:15px;
  margin-bottom:11px;
}
.home-about .about-copy .title-line:before{width:70px}
.home-about .about-copy .title-line:after{width:70px}
.home-about .about-copy p{
  font-size:14px;
  line-height:1.45;
  color:#d8dcdb;
  max-width:780px;
  margin:0 0 14px;
}

/* CTA atelier */
.home-project{
  height:105px;
  border-bottom:1px solid #26383e;
  background:
    linear-gradient(90deg,rgba(2,11,15,.82),rgba(2,11,15,.35)),
    url('about-mug-original.jpg') center/cover no-repeat;
}
.home-project .container{height:100%}
.home-project-copy{
  height:100%;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:25px;
}
.home-project h2{
  margin:0;
  font-size:24px;
  line-height:1.05;
}
.home-project h2 span{
  display:block;
  color:#ff5a00;
}
.home-project .btn{
  min-width:220px;
  background:#ff5a00;
  color:#fff;
  border-color:#ff5a00;
}

/* Footer: desktop base */
.home-page .site-footer{
  background:#02090b;
  border-top:1px solid #27363a;
  overflow:visible;
}
.home-page .footer-main{
  min-height:78px;
  display:flex;
  align-items:center;
  gap:25px;
}
.home-page .footer-logo{
  width:145px;
  height:62px;
  object-fit:contain;
  object-position:left center;
}
.home-page .footer-tag{
  font-size:11px;
  color:#d8dcdb;
}
.home-page .footer-social{
  margin-left:auto;
  display:flex;
  align-items:center;
  gap:16px;
}
.home-page .footer-social span{
  display:flex;
  align-items:center;
  justify-content:center;
  color:#f2f2f2;
  font-family:Arial,sans-serif;
  font-weight:700;
}
.home-page .social-facebook{
  width:25px;height:25px;border:2px solid #f2f2f2;border-radius:50%;font-size:17px;
}
.home-page .social-instagram{
  width:23px;height:23px;border:2px solid #f2f2f2;border-radius:6px;font-size:19px;
}
.home-page .footer-contact{
  display:flex;
  align-items:center;
  gap:18px;
  font-size:11px;
  font-weight:700;
  white-space:nowrap;
}
.home-page .footer-bottom{
  border-top:1px solid #192a30;
  min-height:34px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  font-size:9px;
  color:#cdd2d3;
}

/* Mobile */
@media (max-width:900px){
  html,body{overflow-x:hidden;background:#02090b}
  .home-page .container{width:100%;max-width:none;margin:0;padding-left:30px;padding-right:30px;box-sizing:border-box}
  .home-page .site-header{height:84px;min-height:84px;background:#02090b;border-bottom:1px solid #27383e}
  .home-page .site-header .container.nav{width:100%;height:84px;min-height:84px;padding:0 28px}
  .home-page .site-header .brand-link{height:84px;display:flex;align-items:center}
  .home-page .site-header .logo{width:145px;max-width:145px;height:75px;object-fit:contain}
  .home-page .site-header .navlinks,
  .home-page .site-header .navcta,
  .home-page .nav-phone,
  .home-page .nav-social,
  .home-page .nav-location{display:none}
  .home-page .site-header .menu{
    display:flex;
    align-items:center;
    justify-content:center;
    width:48px;height:48px;
    margin-left:auto;
    border:1px solid #314047;
    border-radius:9px;
    background:#02090b;
    color:#fff;
    font-size:31px;
    line-height:1;
  }
  .home-page .mobile-only{
    display:none;
    position:absolute;
    top:85px;
    left:16px;right:16px;
    z-index:3000;
    background:#02090b;
    border:1px solid #27383e;
  }
  .home-page .mobile-only.open{display:flex;flex-direction:column}
  .home-page .mobile-only a{
    min-height:46px;
    display:flex;
    align-items:center;
    padding:0 18px;
    border-bottom:1px solid #27383e;
  }
  .mobile-location{
    height:54px;
    display:flex;
    align-items:center;
    gap:9px;
    padding:0 34px;
    box-sizing:border-box;
    color:#e8eded;
    font-size:14px;
    background:#02090b;
    border-bottom:1px solid #27383e;
  }
  .mobile-location:first-letter{color:#ff5a00}

  .home-page .home-hero{
    min-height:338px;
    background:
      linear-gradient(90deg,rgba(0,8,10,.93),rgba(0,8,10,.66) 58%,rgba(0,8,10,.18)),
      url('service-gaming-maquette.jpg') left center/cover no-repeat;
  }
  .home-page .home-hero-inner{
    min-height:338px;
    padding-top:27px;
    padding-bottom:18px;
    box-sizing:border-box;
    display:block;
  }
  .home-page .home-copy{max-width:100%;padding:0}
  .home-page .kicker{font-size:13px;letter-spacing:3px}
  .home-page .home-copy h1{font-size:37px;line-height:.98;margin:8px 0 12px;letter-spacing:.2px}
  .home-page .home-copy p{font-size:15px;line-height:1.3;max-width:340px}
  .home-page .script{font-size:18px;margin-top:14px}
  .home-page .home-points{
    width:100%;
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:12px 20px;
    margin-top:16px;
  }
  .home-page .home-point{grid-template-columns:34px 1fr;gap:6px}
  .home-page .home-point .icon{font-size:27px}
  .home-page .home-point strong{font-size:11px}
  .home-page .home-point small{font-size:9px}

  .home-page .section{padding:14px 0}
  .home-page .title-line{gap:12px}
  .home-page .title-line:before,.home-page .title-line:after{width:50px;height:3px;flex:0 0 50px}
  .home-page .section-title{font-size:22px;white-space:nowrap}
  .home-page .section-sub{font-size:11px;line-height:1.2;margin:5px 0 10px}

  .home-inventory .inventory-feature{height:195px}
  .home-inventory .inventory-feature .btn{bottom:14px;min-width:200px;height:40px;font-size:11px}

  .why-grid{grid-template-columns:repeat(2,1fr);border-radius:0}
  .why-grid article{min-height:115px;padding:13px 8px}
  .why-grid article:nth-child(2){border-right:0}
  .why-grid article:nth-child(-n+2){border-bottom:1px solid #26383e}
  .why-icon{font-size:29px}
  .why-grid h3{font-size:13px;margin:7px 0 4px}
  .why-grid p{font-size:10px}

  .home-about .about{
    display:flex;
    flex-direction:column;
    gap:10px;
    position:relative;
  }
  .home-about .about-copy{display:contents}
  .home-about .about-copy .title-line{order:0;justify-content:center;margin-bottom:0}
  .home-about .about-copy h2{font-size:19px}
  .home-about .about img{display:block!important;order:1;width:100%;height:142px;object-fit:cover}
  .home-about .about-copy p{display:none}
  .home-about .about-copy .btn{order:2;position:absolute;right:12px;top:calc(23px + 10px + 142px - 40px);min-height:40px;font-size:10px;background:transparent}

  .home-project{
    height:118px;
    min-height:118px;
    background:
      linear-gradient(90deg,rgba(2,11,15,.78),rgba(2,11,15,.35)),
      url('about-mug-original.jpg') center/cover no-repeat;
  }
  .home-project-copy{padding:14px 30px;box-sizing:border-box;gap:12px}
  .home-project h2{font-size:18px;max-width:58%}
  .home-project .btn{min-width:145px;height:42px;font-size:10px;padding:0 10px}

  /* FOOTER = copie du footer mobile de la page Services approuvée */
  .home-page .site-footer{border-top:1px solid #26383e;background:#020b0f}
  .home-page .site-footer .container{padding:0}
  .home-page .footer-main{
    min-height:100px;
    padding:10px 14px 8px;
    display:grid;
    grid-template-columns:1fr auto;
    grid-template-rows:56px 30px;
    grid-template-areas:"logo social" "contact contact";
    gap:4px 12px;
    align-items:center;
    box-sizing:border-box;
  }
  .home-page .footer-logo{
    grid-area:logo;
    width:132px;height:58px;
    margin:0;
    object-fit:contain;
    object-position:left center;
    content:url('logo-footer-final.png') !important;
  }
  .home-page .footer-tag{display:none}
  .home-page .footer-social{
    grid-area:social;
    display:flex;
    align-items:center;
    justify-content:flex-end;
    gap:18px;
    margin:0;
  }
  .home-page .footer-social .social-facebook{
    width:22px;height:22px;border:2px solid #f2f2f2;border-radius:50%;font-size:16px
  }
  .home-page .footer-social .social-instagram{
    width:20px;height:20px;border:2px solid #f2f2f2;border-radius:6px;font-size:18px
  }
  .home-page .footer-contact{
    grid-area:contact;
    width:100%;
    margin:0;
    display:flex;
    justify-content:flex-start;
    align-items:center;
    gap:3px 8px;
    flex-wrap:wrap;
    font-size:7.5px;
    line-height:1.15;
    text-align:left;
  }
  .home-page .footer-contact span{display:inline-flex;white-space:nowrap}
  .home-page .footer-bottom{
    width:100%;
    min-height:36px;height:36px;
    padding:6px 12px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:8px;
    text-align:left;
    font-size:8.5px;
    line-height:1.2;
    box-sizing:border-box;
  }
}
@media(max-width:520px){
  .home-page .container{padding-left:30px;padding-right:30px}
  .home-page .site-header .container.nav{padding:0 28px}
  .home-page .home-copy h1{font-size:34px}
  .home-page .home-copy p{font-size:14px}
  .home-page .home-hero{min-height:338px}
  .home-page .home-hero-inner{min-height:338px}
  .home-page .home-points{gap:10px 14px}
  .home-page .home-point strong{font-size:10px}
  .home-page .home-point small{font-size:8.5px}
  .home-page .section-title{font-size:20px}
  .home-page .home-project h2{font-size:17px}
  .home-page .home-project .btn{min-width:135px;font-size:9.5px}
}


/* =========================================================
   ACCUEIL MOBILE — CALAGE SUR LA MAQUETTE APPROUVÉE
   Cible principale : largeur mobile ~305px.
   Desktop volontairement laissé intact pour la prochaine passe.
   ========================================================= */
@media (max-width:900px){
  .home-page .container{padding-left:13px;padding-right:13px;}

  /* HEADER */
  .home-page .site-header{height:80px;min-height:80px;}
  .home-page .site-header .container.nav{height:80px;min-height:80px;padding:0 25px;}
  .home-page .site-header .brand-link{height:80px;}
  .home-page .site-header .logo{width:105px;height:64px;max-width:105px;}
  .home-page .site-header .menu{width:42px;height:42px;font-size:28px;border-radius:8px;}

  /* LOCALISATION */
  .home-page .mobile-location{height:38px;padding:0 28px;gap:7px;font-size:13px;}

  /* HERO */
  .home-page .home-hero,
  .home-page .home-hero-inner{min-height:287px;height:287px;}
  .home-page .home-hero{
    background:
      linear-gradient(90deg,rgba(0,8,10,.90) 0%,rgba(0,8,10,.63) 56%,rgba(0,8,10,.16) 100%),
      url('service-gaming-maquette.jpg') center center/cover no-repeat;
  }
  .home-page .home-hero-inner{padding:12px 27px 10px;}
  .home-page .kicker{font-size:11px;letter-spacing:2.5px;}
  .home-page .home-copy h1{font-size:27px;line-height:.98;margin:6px 0 9px;letter-spacing:0;}
  .home-page .home-copy p{font-size:12px;line-height:1.25;max-width:265px;}
  .home-page .script{font-size:15px;line-height:1.02;margin-top:11px;}
  .home-page .home-points{gap:8px 13px;margin-top:11px;}
  .home-page .home-point{grid-template-columns:30px 1fr;gap:5px;}
  .home-page .home-point .icon{font-size:25px;}
  .home-page .home-point strong{font-size:9px;line-height:1.05;}
  .home-page .home-point small{font-size:7.5px;line-height:1.15;margin-top:2px;}

  /* WHY */
  .home-page .home-why{padding:10px 0 12px;}
  .home-page .home-why .container{padding-left:13px;padding-right:13px;}
  .home-page .title-line{gap:8px;}
  .home-page .title-line:before,.home-page .title-line:after{width:29px;flex:0 0 29px;height:3px;}
  .home-page .section-title{font-size:18px;letter-spacing:0;}
  .home-page .why-grid{border-radius:0;}
  .home-page .why-grid article{min-height:72px;height:72px;padding:8px 4px;}
  .home-page .why-icon{font-size:24px;}
  .home-page .why-grid h3{font-size:11px;margin:5px 0 2px;}
  .home-page .why-grid p{font-size:8px;line-height:1.15;}

  /* ABOUT */
  .home-page .home-about{padding:9px 0 0;}
  .home-page .home-about .about{gap:6px;}
  .home-page .home-about .about-copy .title-line{margin-bottom:0;}
  .home-page .home-about .about-copy h2{font-size:16px;}
  .home-page .home-about .about img{width:100%;height:111px;object-fit:cover;display:block!important;}
  .home-page .home-about .about-copy p{display:none;}
  .home-page .home-about .about-copy .btn{
    top:auto;right:8px;bottom:8px;z-index:2;
    min-height:32px;height:32px;padding:0 10px;font-size:8px;
    background:rgba(2,9,11,.30);color:#fff;
  }

  /* CTA */
  .home-page .home-project{height:130px;min-height:130px;background:
    linear-gradient(90deg,rgba(2,11,15,.76),rgba(2,11,15,.35)),
    url('about-mug-original.jpg') center/cover no-repeat;}
  .home-page .home-project .container{height:100%;padding-left:27px;padding-right:27px;}
  .home-page .home-project-copy{height:100%;padding:11px 0 9px;display:flex;flex-direction:column;align-items:flex-start;justify-content:flex-start;gap:5px;}
  .home-page .home-project h2{font-size:16px;line-height:1.02;max-width:100%;}
  .home-page .home-project .btn{width:172px;min-width:172px;height:39px;min-height:39px;font-size:9px;padding:0 8px;align-self:center;margin-top:auto;margin-bottom:1px;}

  /* FOOTER — même composition que la maquette mobile */
  .home-page .site-footer{border-top:1px solid #26383e;}
  .home-page .site-footer .container{padding:0;}
  .home-page .footer-main{
    min-height:126px;height:126px;padding:8px 14px 6px;
    display:grid!important;
    grid-template-columns:1fr auto;
    grid-template-rows:55px 1fr;
    grid-template-areas:"logo social" "contact contact";
    gap:3px 10px;
    align-items:center;
  }
  .home-page .footer-logo{
    grid-area:logo;flex:initial!important;
    width:108px!important;height:55px!important;
    margin:0!important;object-fit:contain;object-position:left center;
    content:url('logo-footer-final.png')!important;
  }
  .home-page .footer-social{grid-area:social;display:flex!important;justify-content:flex-end;align-items:center;gap:14px;margin:0!important;letter-spacing:0!important;}
  .home-page .footer-social .social-facebook{width:25px;height:25px;font-size:17px;}
  .home-page .footer-social .social-instagram{width:24px;height:24px;font-size:19px;}
  .home-page .footer-contact{
    grid-area:contact;width:100%!important;margin:0!important;
    display:grid!important;grid-template-columns:1fr auto;grid-template-rows:repeat(2,auto);
    justify-content:initial;align-items:center;gap:4px 8px;
    font-size:8.5px!important;line-height:1.15;text-align:left!important;
  }
  .home-page .footer-contact span{display:inline-flex!important;white-space:nowrap;justify-content:flex-start;}
  .home-page .footer-contact span:nth-child(1){grid-column:1/-1;}
  .home-page .footer-contact span:nth-child(2){grid-column:1;}
  .home-page .footer-contact span:nth-child(3){grid-column:2;}
  .home-page .footer-bottom{height:38px;min-height:38px;padding:5px 7px;display:flex!important;justify-content:center;align-items:center;gap:3px 7px;text-align:center;font-size:7px;line-height:1.15;}
}
@media(max-width:520px){
  .home-page .home-copy h1{font-size:27px;}
  .home-page .home-copy p{font-size:12px;}
  .home-page .home-points{gap:8px 11px;}
  .home-page .home-point strong{font-size:8.5px;}
  .home-page .home-point small{font-size:7.3px;}
}

/* MOBILE — logo central dans le Hero, conforme à la maquette approuvée */
@media (max-width:900px){
  .home-page .home-hero{position:relative;overflow:hidden;}
  .home-page .home-hero-logo-mobile{
    display:block!important;
    position:absolute!important;
    width:78px!important;
    height:auto!important;
    left:50%!important;
    bottom:9px!important;
    transform:translateX(-50%)!important;
    z-index:2!important;
    object-fit:contain!important;
  }
}

/* =========================================================
   ACCUEIL MOBILE — DERNIÈRE PASSE / RÉFÉRENCE MAQUETTE
   Desktop volontairement inchangé.
   ========================================================= */
@media (max-width:900px){
  html,body{overflow-x:hidden;background:#02090b;}

  /* HEADER — même identité visuelle que Services approuvé */
  .home-page .site-header{height:80px!important;min-height:80px!important;background:#02090b!important;position:sticky!important;top:0!important;z-index:6000!important;}
  .home-page .site-header .container.nav{width:100%!important;height:80px!important;min-height:80px!important;padding:0 25px!important;}
  .home-page .site-header .brand-link{height:80px!important;display:flex!important;align-items:center!important;}
  .home-page .site-header .logo{content:url('forgepc-logo-web.png')!important;width:105px!important;height:64px!important;max-width:105px!important;object-fit:contain!important;}
  .home-page .site-header .menu{display:flex!important;align-items:center!important;justify-content:center!important;width:42px!important;height:42px!important;margin-left:auto!important;border:1px solid #314047!important;border-radius:8px!important;background:#02090b!important;color:#fff!important;font-size:28px!important;line-height:1!important;}
  .home-page .site-header .navlinks,.home-page .site-header .nav-location{display:none!important;}
  .home-page .mobile-only{display:none!important;}
  .home-page .mobile-only.open{display:flex!important;position:fixed!important;top:80px!important;left:10px!important;right:10px!important;z-index:5999!important;flex-direction:column!important;}

  /* LOCALISATION */
  .home-page .mobile-location{height:38px!important;min-height:38px!important;padding:0 28px!important;display:flex!important;align-items:center!important;gap:7px!important;box-sizing:border-box!important;background:#02090b!important;border-bottom:1px solid #27383e!important;color:#e8eded!important;font-size:13px!important;}

  /* HERO */
  .home-page .home-hero{height:288px!important;min-height:288px!important;overflow:hidden!important;position:relative!important;background:
    linear-gradient(90deg,rgba(0,8,10,.82) 0%,rgba(0,8,10,.48) 58%,rgba(0,8,10,.10) 100%),
    url('service-gaming-maquette.jpg') center center/cover no-repeat!important;border-bottom:1px solid #29383d!important;}
  .home-page .home-hero-inner{height:288px!important;min-height:288px!important;padding:12px 27px 8px!important;box-sizing:border-box!important;display:block!important;position:relative!important;}
  .home-page .home-copy{max-width:none!important;padding:0!important;position:relative!important;z-index:3!important;}
  .home-page .kicker{font-size:11px!important;letter-spacing:2.5px!important;line-height:1!important;}
  .home-page .home-copy h1{font-size:27px!important;line-height:.98!important;letter-spacing:0!important;margin:7px 0 9px!important;}
  .home-page .home-copy p{font-size:12px!important;line-height:1.25!important;max-width:270px!important;margin:0!important;}
  .home-page .script{font-size:15px!important;line-height:1.02!important;margin-top:11px!important;}
  .home-page .home-points{width:100%!important;display:grid!important;grid-template-columns:1fr 1fr!important;gap:8px 13px!important;margin-top:11px!important;position:relative!important;z-index:4!important;}
  .home-page .home-point{grid-template-columns:30px 1fr!important;gap:5px!important;align-items:center!important;}
  .home-page .home-point .icon{font-size:25px!important;line-height:1!important;color:#ff5a00!important;}
  .home-page .home-point strong{font-size:9px!important;line-height:1.05!important;display:block!important;}
  .home-page .home-point small{font-size:7.5px!important;line-height:1.15!important;margin-top:2px!important;display:block!important;}
  .home-page .home-hero-logo-mobile{display:block!important;position:absolute!important;width:55px!important;height:auto!important;left:50%!important;bottom:7px!important;transform:translateX(-50%)!important;z-index:5!important;object-fit:contain!important;content:url('forgepc-logo-web.png')!important;}

  /* WHY */
  .home-page .home-why{padding:10px 0 12px!important;border-bottom:1px solid #25363c!important;}
  .home-page .home-why .container{padding-left:18px!important;padding-right:18px!important;}
  .home-page .home-why .title-line{gap:8px!important;}
  .home-page .home-why .title-line:before,.home-page .home-why .title-line:after{width:29px!important;flex:0 0 29px!important;height:3px!important;}
  .home-page .home-why .section-title{font-size:18px!important;letter-spacing:0!important;white-space:nowrap!important;}
  .home-page .why-grid{grid-template-columns:repeat(2,1fr)!important;border:1px solid #26383e!important;border-radius:0!important;overflow:hidden!important;}
  .home-page .why-grid article{min-height:66px!important;height:66px!important;padding:8px 4px!important;background:#020b0f!important;border-right:1px solid #26383e!important;border-bottom:1px solid #26383e!important;}
  .home-page .why-grid article:nth-child(2n){border-right:0!important;}
  .home-page .why-grid article:nth-child(n+3){border-bottom:0!important;}
  .home-page .why-icon{font-size:24px!important;line-height:1!important;color:#ff5a00!important;}
  .home-page .why-grid h3{font-size:11px!important;line-height:1!important;margin:5px 0 2px!important;}
  .home-page .why-grid p{font-size:8px!important;line-height:1.15!important;margin:0!important;}

  /* ABOUT — titre puis image pleine largeur avec bouton posé dessus */
  .home-page .home-about{padding:9px 0 0!important;border-bottom:1px solid #25363c!important;}
  .home-page .home-about .about{display:flex!important;flex-direction:column!important;gap:6px!important;position:relative!important;padding:0 18px!important;}
  .home-page .home-about .about-copy{display:contents!important;}
  .home-page .home-about .about-copy .title-line{order:0!important;justify-content:center!important;gap:8px!important;margin:0!important;}
  .home-page .home-about .about-copy .title-line:before,.home-page .home-about .about-copy .title-line:after{width:29px!important;flex:0 0 29px!important;}
  .home-page .home-about .about-copy h2{font-size:16px!important;line-height:1!important;margin:0!important;white-space:nowrap!important;}
  .home-page .home-about .about img{display:block!important;order:1!important;width:100%!important;height:111px!important;object-fit:cover!important;object-position:center!important;border-radius:0!important;}
  .home-page .home-about .about-copy p{display:none!important;}
  .home-page .home-about .about-copy .btn{order:2!important;position:absolute!important;right:8px!important;bottom:8px!important;z-index:6!important;height:32px!important;min-height:32px!important;padding:0 10px!important;font-size:8px!important;background:rgba(2,9,11,.30)!important;color:#fff!important;border-color:#ff5a00!important;}

  /* CTA */
  .home-page .home-project{height:131px!important;min-height:131px!important;background:
    linear-gradient(90deg,rgba(2,11,15,.76),rgba(2,11,15,.32)),
    url('about-mug-original.jpg') center/cover no-repeat!important;border-bottom:1px solid #26383e!important;}
  .home-page .home-project .container{height:100%!important;padding-left:27px!important;padding-right:27px!important;box-sizing:border-box!important;}
  .home-page .home-project-copy{height:100%!important;padding:11px 0 9px!important;display:flex!important;flex-direction:column!important;align-items:flex-start!important;justify-content:flex-start!important;gap:5px!important;box-sizing:border-box!important;}
  .home-page .home-project h2{font-size:16px!important;line-height:1.02!important;max-width:100%!important;margin:0!important;}
  .home-page .home-project .btn{width:172px!important;min-width:172px!important;height:39px!important;min-height:39px!important;font-size:9px!important;padding:0 8px!important;align-self:center!important;margin-top:auto!important;margin-bottom:1px!important;background:#ff5a00!important;border-color:#ff5a00!important;}

  /* FOOTER — même structure que la maquette mobile */
  .home-page .site-footer{border-top:1px solid #26383e!important;background:#020b0f!important;}
  .home-page .site-footer .container{padding:0!important;width:100%!important;}
  .home-page .footer-main{min-height:136px!important;height:136px!important;padding:8px 18px 7px!important;display:grid!important;grid-template-columns:1fr auto!important;grid-template-rows:56px 1fr!important;grid-template-areas:"logo social" "contact contact"!important;gap:4px 10px!important;align-items:center!important;box-sizing:border-box!important;}
  .home-page .footer-logo{grid-area:logo!important;width:108px!important;height:55px!important;margin:0!important;object-fit:contain!important;object-position:left center!important;content:url('logo-footer-final.png')!important;}
  .home-page .footer-tag{display:none!important;}
  .home-page .footer-social{grid-area:social!important;display:flex!important;justify-content:flex-end!important;align-items:center!important;gap:14px!important;margin:0!important;}
  .home-page .footer-social .social-facebook{width:25px!important;height:25px!important;font-size:17px!important;}
  .home-page .footer-social .social-instagram{width:24px!important;height:24px!important;font-size:19px!important;}
  .home-page .footer-contact{grid-area:contact!important;width:100%!important;margin:0!important;display:grid!important;grid-template-columns:1fr!important;grid-template-rows:repeat(3,auto)!important;gap:4px!important;font-size:8.5px!important;line-height:1.15!important;text-align:left!important;justify-items:start!important;}
  .home-page .footer-contact span{display:inline-flex!important;white-space:nowrap!important;justify-content:flex-start!important;}
  .home-page .footer-contact span:nth-child(1),.home-page .footer-contact span:nth-child(2),.home-page .footer-contact span:nth-child(3){grid-column:1!important;}
  .home-page .footer-bottom{height:38px!important;min-height:38px!important;padding:5px 7px!important;display:flex!important;justify-content:center!important;align-items:center!important;gap:3px 7px!important;text-align:center!important;font-size:7px!important;line-height:1.15!important;box-sizing:border-box!important;}
}
@media(max-width:520px){
  .home-page .home-copy h1{font-size:27px!important;}
  .home-page .home-copy p{font-size:12px!important;}
  .home-page .home-points{gap:8px 11px!important;}
  .home-page .home-point strong{font-size:8.5px!important;}
  .home-page .home-point small{font-size:7.3px!important;}
}
